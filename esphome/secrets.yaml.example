# Copy to esphome/secrets.yaml (git-ignored) and fill in.
# Key names match the other ESPHome configs in ~/development/esphome so one
# secrets file can be reused by symlink if preferred.
wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"
fallback_password: "somethingmemorable"
api_encryption_key: "generate with: esphome wizard, or openssl rand -base64 32"
ota_password: "another_password"
# Used by hestian-dial-heatpump.yaml and hestian-dial-conventional.yaml
hestian_api_key: "generate with: openssl rand -base64 32"
hestian_ota_password: "another_password"
